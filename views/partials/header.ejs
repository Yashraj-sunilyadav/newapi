<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>

    <style>
      .header {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        padding: 30px 70px;
      }
      @import url("https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap");

      .navbar {
        display: flex;
        gap: 59px;
        align-items: center;
        color: white;
        color: var(--Color-1, #fff);
        font-family: "Manrope", sans-serif;
        font-size: 16px;
        text-transform: capitalize;

        font-style: normal;
        font-weight: 400;
        line-height: normal;
      }
    </style>
  </head>
  <body>
    <div class="header">
      <div class="logo">
        <img src="/image/WanderWise Mountain Logo 1.png" alt="" />
      </div>
      <div class="navbar">
        <div class="button">
          <span>Discover</span>
        </div>
        <div class="button">
          <span>Explore</span>
        </div>
        <div class="button">
          <img src="/image/andrsrxn_map-pin-check.png" alt="" srcset="" />
        </div>
        <div class="button">
          <span>Map</span>
        </div>
        <div class="button">
          <span>Saved</span>
        </div>
      </div>
      <div class="action navbar">
        <div class="button">
          <img src="/image/Vector (3).png" alt="" srcset="" />
        </div>
        <div class="button">
          <img src="/image/ic_baseline-account-circle.png" alt="" srcset="" />
        </div>
      </div>
    </div>
  </body>
</html>
