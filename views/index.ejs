<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap");
      body {
        padding: 0%;
        margin: 0%;
        background-color: black;
        background-image: url("/image/Alpenglow\ Over\ a\ Glacial\ Mountain\ Valley\ 1.png");
        background-repeat: no-repeat;
        display: flex;
        flex-direction: column;
        height: 100vh;
      }

      .header {
        flex-shrink: 0;
      }

      .herotext {
        padding: 0px 50px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-top: 10px;
      }

      .herotext > h1 {
        color: var(--Color-1, #fff);
        font-family: "Manrope", sans-serif;
        font-size: 70px;
        font-style: normal;
        font-weight: 400;
        line-height: normal;
        text-transform: capitalize;
        margin: 0%;
      }
      .herotext > h5 {
        color: var(--Color-1, #fff);
        font-family: "Manrope", sans-serif;
        font-style: normal;
        font-weight: 400;
        line-height: normal;
        text-transform: capitalize;
        margin: 0%;
      }

      /* Search form */
      .search-form {
        width: min(580px, calc(100% - 80px));
        height: 40px;
        box-sizing: border-box;
        margin-top: 20px;
        display: flex;
        align-items: center;
        gap: 12px;

        padding: 4px;
        border: 1px solid rgba(255, 255, 255, 0.85);
        border-radius: 61px;

        background: rgba(217, 217, 217, 0.18);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);

        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.15);

        color: #fff;
        overflow: hidden;
      }

      /* Search icon */
      .search-icon {
        flex-shrink: 0;
        margin-left: 20px;
        opacity: 0.95;
      }

      /* Input field */
      .search-form input {
        flex: 1;
        min-width: 0;
        height: 100%;

        padding: 0;
        border: none;
        outline: none;

        background: transparent;
        color: #fff;

        font-family: "Manrope", sans-serif;
        font-size: 15px;
        font-weight: 400;
      }

      .search-form input::placeholder {
        color: rgba(255, 255, 255, 0.7);
        opacity: 1;
      }

      /* Search button */
      .search-form button {
        flex-shrink: 0;
        height: 37px;
        min-width: 92px;

        padding: 0 22px;
        border: none;
        border-radius: 61px;

        background: #08090d;
        color: #fff;

        font-family: "Manrope", sans-serif;
        font-size: 15px;
        font-weight: 500;

        cursor: pointer;
        transition: background 0.2s ease;
      }

      .search-form button:hover {
        background: #24262d;
      }

      .search-form:focus-within {
        border-color: #fff;
        box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.12);
      }

      /* Small screens */
      @media (max-width: 480px) {
        .search-form {
          width: calc(100% - 32px);
          gap: 8px;
        }

        .search-icon {
          margin-left: 12px;
        }

        .search-form input {
          font-size: 13px;
        }

        .search-form button {
          min-width: 76px;
          padding: 0 16px;
          font-size: 13px;
        }
      }
      .choose{
        display: flex;
        padding-top: 15px;
        flex-direction: column;
        align-items: center;
        gap: 15px;
      }
      .choose > p {
        margin: 0;
        color: white;
        text-align: center;
        font-family: "Manrope", sans-serif;
        font-size: 48px;
        font-style: normal;
        font-weight: 500;

        line-height: 48px; /* 100% */
        letter-spacing: -1.2px;
      }
      .choose > span {
        margin: 0%;
        color: #fff;
        text-align: center;
       font-family: "Manrope", sans-serif;
        font-size: 14px;
        font-style: normal;
        font-weight: 400;
        line-height: 20px; /* 142.857% */
      }
      .choose > .filter{
        display: flex;
        flex-direction: row;
        gap: 7px;
        flex-wrap: wrap;
      }
    .choose > .filter > button{
      display: flex;
      color: #fff;
       background-color: transparent;
padding: 6px 12px;
flex-direction: column;
justify-content: center;
align-items: center;
border-radius: 9999px;
border: 1px solid rgba(226, 232, 240, 0.80);
      }
      #all{
        border-radius: 9999px;
background: #111827;
box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
      }

.filter button:hover {
    background-color: #222;
    color: white;
    border: 1px solid white;
    cursor: pointer;
}

.filter button.active {
    background-color: #222;
    color: white;
    border: 1px solid white;
}

